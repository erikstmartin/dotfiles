.vscode
.DS_Store
*.swp
*.swo
tags

.env.local
.gitconfig-local
fish/.config/fish/conf.d/local.fish

# gh CLI — contains per-machine auth info (tokens stored in Keychain, but username/host is machine-specific)
gh/.config/gh/hosts.yml

# bin — ignore everything except explicitly tracked scripts
bin/.local/bin/*
!bin/.local/bin/project-skills
!bin/.local/bin/rename-with-icon.sh
!bin/.local/bin/tmux-cpu.sh
!bin/.local/bin/tmux-mem.sh
!bin/.local/bin/wsl-browser

# fish universal variables — machine-generated with absolute paths; fisher plugins tracked via fish_plugins instead
fish/.config/fish/fish_variables

# Global agent skills — track skill definitions only; runtime state remains local
agents/.agents/*
!agents/.agents/skills/
!agents/.agents/skills/**

# Copilot CLI — ignore everything except intentional config
copilot/.copilot/*
!copilot/.copilot/copilot-instructions.md
!copilot/.copilot/settings.json

# Superpowers working docs should stay local
docs/superpowers/

# Azure CLI: only the settings file; ~/.azure also holds login tokens and logs
azure/.azure/*
!azure/.azure/config

# Claude Code — ignore everything except intentional config (runtime/history/sessions stay local)
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/agents
!claude/.claude/skills
!claude/.claude/commands
!claude/.claude/hooks

# Codex CLI — track only the sanitized example; live config has tokens + machine-specific state
codex/.codex/*
!codex/.codex/config.toml.example


# OMO (oh-my-openagent) project runtime state
/.omo/

# mise: per-machine module selection and local overrides
mise/.config/mise/conf.d/
mise/.config/mise/config.local.toml

# carapace: bridge files are regenerated by carapace at runtime
carapace/.config/carapace/bridge/
