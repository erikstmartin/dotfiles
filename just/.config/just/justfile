# Dotfiles management

[doc("Link the dotfiles (scripts/dotfiles.sh link / dotfiles.ps1 link)")]
[group('dotfiles')]
dotfiles-link:
    {{ if os == "windows" { "& \"" + dotfiles + "\\scripts\\dotfiles.ps1\" link" } else { "\"" + dotfiles + "/scripts/dotfiles.sh\" link" } }}

[doc("Unlink the dotfiles (scripts/dotfiles.sh unlink / dotfiles.ps1 unlink)")]
[group('dotfiles')]
dotfiles-unlink:
    {{ if os == "windows" { "& \"" + dotfiles + "\\scripts\\dotfiles.ps1\" unlink" } else { "\"" + dotfiles + "/scripts/dotfiles.sh\" unlink" } }}

[doc("Pull the latest dotfiles, then update everything")]
[group('dotfiles')]
dotfiles-update:
    git -C "{{ dotfiles }}" pull --ff-only
    @just --global-justfile update
